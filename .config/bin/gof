#!/bin/bash

# Get the remote URL, preferring origin when available.
url=$(git remote get-url origin 2>/dev/null || git remote -v | awk 'NR == 1 {print $2}')

# Convert SSH URLs to HTTPS.
url=$(printf '%s\n' "$url" \
  | sed -r 's#^ssh://git@([^/]+)/(.+)#https://\1/\2#' \
  | sed -r 's#^git@([^:]+):(.+)#https://\1/\2#' \
  | sed 's/\.git$//')

# Open the URL in the browser
echo "trying to open: $url"
xdg-open $url
